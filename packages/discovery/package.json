{
  "name": "@webbpulse/discovery",
  "version": "0.10.3",
  "description": "Uncredentialed capability discovery for the WebbPulse identity service: what a deployment does with passkeys, and which OAuth providers it has configured.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebbPulse/webbpulse-typescript.git",
    "directory": "packages/discovery"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@webbpulse/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@webbpulse/auth": "0.10.3"
  },
  "devDependencies": {
    "@webbpulse/tsconfig": "0.10.3"
  }
}

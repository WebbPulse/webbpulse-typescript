{
  "name": "@webbpulse/auth",
  "version": "0.1.0",
  "description": "Framework free session helpers for WebbPulse applications, with an optional React entry point.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebbPulse/webbpulse-typescript.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "development": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@webbpulse/api-client": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@webbpulse/tsconfig": "0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}

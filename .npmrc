# CodeArtifact registry binding for the @webbpulse scope.
#
# Nothing estate specific is committed here. Both values are read from the
# environment, so a checkout without them still installs the public
# dependencies and only fails to resolve @webbpulse packages, which this
# repository does not consume from the registry anyway.
#
# Populate them before installing in a consumer application:
#
#   export CODEARTIFACT_DOMAIN_OWNER=<artifacts account id>
#   export CODEARTIFACT_REGISTRY_HOST="webbpulse-${CODEARTIFACT_DOMAIN_OWNER}.d.codeartifact.us-west-2.amazonaws.com/npm/npm/"
#   export CODEARTIFACT_AUTH_TOKEN=$(aws codeartifact get-authorization-token \
#     --domain webbpulse --domain-owner "$CODEARTIFACT_DOMAIN_OWNER" \
#     --region us-west-2 --query authorizationToken --output text)
#
# `aws codeartifact login --tool npm --domain webbpulse --repository npm`
# writes the equivalent pair into ~/.npmrc and is the shorter path. This file
# exists so the scope binding is explicit and version controlled rather than
# depending on a machine local login having been run.
@webbpulse:registry=https://${CODEARTIFACT_REGISTRY_HOST}
//${CODEARTIFACT_REGISTRY_HOST}:_authToken=${CODEARTIFACT_AUTH_TOKEN}
